/**app.wxss**/
page {
  --primary: #0052D9;
  --primary-light: #366EF4;
  --primary-dark: #003CAB;
  --primary-bg: #E8F2FF;
  --success: #00A870;
  --warning: #ED7B2F;
  --danger: #E34D59;
  --text-color: #1D2129;
  --text-secondary: #4E5969;
  --text-muted: #86909C;
  --text-placeholder: #C9CDD4;
  --bg-color: #F5F6FA;
  --border-color: #E5E6EB;
  --border-light: #F2F3F5;
  --white: #FFFFFF;
  --radius-sm: 6px;
  --radius: 10px;
  --radius-lg: 14px;
  --radius-xl: 20px;
  --transition: 0.2s cubic-bezier(0.38, 0, 0.24, 1);

  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', STHeiti, 'Microsoft Yahei', Tahoma, Simsun, sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
  color: var(--text-color);
  background-color: var(--bg-color);
  box-sizing: border-box;
}

/* 通用工具类 */
.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-col {
  display: flex;
  flex-direction: column;
}

.flex-1 {
  flex: 1;
}

.text-center {
  text-align: center;
}

.text-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.text-ellipsis-2 {
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* 安全区域底部 */
.safe-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

/* 页面动画 */
.page-fade-in {
  animation: fadeIn 0.25s ease;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(12rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 课程卡片网格 */
.course-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 20rpx 24rpx;
}

.course-grid .course-card-wrap {
  width: 50%;
  padding: 10rpx;
  box-sizing: border-box;
}

/* 空状态 */
.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-muted);
}

.empty-sub-text {
  font-size: 24rpx;
  color: var(--text-placeholder);
  margin-top: 8rpx;
}

/* 骨架屏 */
.skeleton-card {
  background: var(--white);
  border-radius: var(--radius);
  overflow: hidden;
  margin-bottom: 20rpx;
}

.skeleton-img {
  width: 100%;
  height: 272rpx;
  background: linear-gradient(90deg, #f2f3f5 25%, #e8eaed 50%, #f2f3f5 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
}

.skeleton-text {
  padding: 20rpx 24rpx;
}

.skeleton-line {
  height: 28rpx;
  background: #f2f3f5;
  border-radius: 4rpx;
  margin-bottom: 16rpx;
}

.skeleton-line.short {
  width: 60%;
}

@keyframes shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* 全局按钮样式 */
.btn-primary {
  background: var(--primary) !important;
  color: #fff !important;
  border: none !important;
  border-radius: 48rpx !important;
}

.btn-primary:active {
  opacity: 0.85;
}

.btn-danger-outline {
  background: transparent !important;
  color: var(--danger) !important;
  border: 2rpx solid var(--danger) !important;
  border-radius: 48rpx !important;
}
