.qa-float-btn {
  position: fixed;
  right: 24rpx;
  bottom: 200rpx;
  z-index: 999;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 104rpx;
  height: 104rpx;
  background: linear-gradient(135deg, #1989fa, #07c160);
  border-radius: 50%;
  box-shadow: 0 8rpx 24rpx rgba(25, 137, 250, 0.4);
}

.qa-float-btn:active {
  transform: scale(0.92);
}

.qa-float-icon {
  font-size: 40rpx;
  line-height: 1;
}

.qa-float-text {
  font-size: 18rpx;
  color: #fff;
  margin-top: 4rpx;
  font-weight: 500;
}
