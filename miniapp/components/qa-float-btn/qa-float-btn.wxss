.qa-float-btn {
  position: fixed;
  right: 24rpx;
  bottom: 200rpx;
  z-index: 999;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  padding: 16rpx 28rpx;
  background: linear-gradient(135deg, #1989fa, #07c160);
  border-radius: 60rpx;
  box-shadow: 0 8rpx 28rpx rgba(25, 137, 250, 0.45);
}

.qa-float-btn:active {
  transform: scale(0.95);
  opacity: 0.9;
}

.qa-float-icon {
  font-size: 36rpx;
  line-height: 1;
  margin-right: 10rpx;
}

.qa-float-text {
  font-size: 26rpx;
  color: #fff;
  font-weight: 600;
  letter-spacing: 2rpx;
  white-space: nowrap;
}
