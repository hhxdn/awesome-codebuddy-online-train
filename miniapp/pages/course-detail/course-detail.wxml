<!--pages/course-detail/course-detail.wxml-->
<view class="course-detail-page page-fade-in">
  <!-- Top Banner -->
  <view class="detail-banner">
    <view class="banner-body">
      <view class="banner-title">{{course.title}}</view>
      <view class="banner-tags">
        <text class="banner-tag {{(course.price || 0) === 0 ? 'tag-free' : 'tag-paid'}}">
          {{(course.price || 0) === 0 ? '免费' : '¥' + course.price}}
        </text>
        <text class="banner-tag tag-cat">{{course.categoryPath || course.categoryName}}</text>
        <text wx:if="{{course.courseType === 'OFFLINE'}}" class="banner-tag tag-offline">线下课程</text>
      </view>
      <view class="banner-stats">
        <text>{{course.studentCount || 0}}人在学</text>
      </view>
    </view>
  </view>

  <!-- Description -->
  <view class="section-card">
    <view class="section-title">课程介绍</view>
    <view class="desc-text {{descExpanded ? 'expanded' : ''}}">
      {{course.description || '暂无介绍'}}
    </view>
    <view wx:if="{{hasLongDesc}}" class="desc-toggle" bindtap="toggleDesc">
      {{descExpanded ? '收起' : '展开全部'}}
      <text class="toggle-arrow">{{descExpanded ? '▲' : '▼'}}</text>
    </view>
  </view>

  <!-- Chapters -->
  <view class="section-card">
    <view class="section-title">
      课程目录
      <text class="chapter-total">共{{chapters.length}}节</text>
    </view>
    <view wx:if="{{chapters.length > 0}}">
      <view wx:for="{{chapters}}" wx:key="id" class="chapter-item" bindtap="goChapter" data-ch="{{item}}">
        <view class="chapter-num">{{index < 9 ? '0' + (index+1) : index+1}}</view>
        <view class="chapter-info">
          <view class="chapter-name text-ellipsis-2">{{item.title}}</view>
          <view class="chapter-bottom">
            <text class="chapter-dur">▶ {{item.duration || '视频'}}</text>
            <text wx:if="{{item.completed}}" class="chapter-done">✅ 已学完</text>
          </view>
        </view>
        <view class="chapter-right">
          <button wx:if="{{!isPaid || purchased}}" class="practice-btn" size="mini" bindtap="goPractice" data-ch="{{item}}">练习</button>
          <text wx:else class="lock-icon">🔒</text>
        </view>
      </view>
    </view>
    <view wx:else class="empty-wrap" style="padding:40rpx 0;">
      <text class="empty-text">暂无章节</text>
    </view>
  </view>

  <!-- Bottom Bar -->
  <view class="bottom-bar safe-bottom">
    <!-- 线下课程 -->
    <block wx:if="{{course.courseType === 'OFFLINE'}}">
      <button wx:if="{{!checkedIn}}" class="checkin-btn" bindtap="goCheckin">
        📍 线下打卡
      </button>
      <button wx:if="{{!checkedIn}}" class="reserve-btn" bindtap="goReserve">
        📅 预约课程
      </button>
      <button wx:else class="checked-in-btn" disabled>
        ✅ 已打卡
      </button>
    </block>

    <!-- 免费课程 -->
    <button wx:elif="{{(course.price || 0) === 0}}" class="bottom-btn" bindtap="startLearn">
      开始学习
    </button>

    <!-- 付费未购买 -->
    <block wx:elif="{{!purchased}}">
      <view class="bottom-left">
        <text class="price-label">价格</text>
        <text class="price-value">¥{{course.price}}</text>
      </view>
      <button class="bottom-btn-half" bindtap="buyNow">购买课程</button>
      <button wx:if="{{belongCategory}}" class="bottom-btn-half category-btn" bindtap="buyCategory">购买分类 ¥{{belongCategory.price}}</button>
    </block>

    <!-- 付费已购买 -->
    <button wx:else class="bottom-btn" bindtap="startLearn">
      继续学习
    </button>
  </view>
<qa-float-btn />
</view>
