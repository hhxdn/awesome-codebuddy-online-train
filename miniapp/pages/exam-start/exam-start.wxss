/* pages/exam-start/exam-start.wxss */
.exam-start-page {
  min-height: 100vh;
  background: var(--bg-color);
  padding: 24rpx;
}

.exam-info-card {
  background: linear-gradient(135deg, var(--primary), var(--primary-light));
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
  margin-bottom: 24rpx;
  text-align: center;
}

.exam-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.exam-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 36rpx;
}

.exam-stats {
  display: flex;
  align-items: center;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  display: block;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: rgba(255,255,255,0.7);
}

.stat-divider {
  width: 2rpx;
  height: 60rpx;
  background: rgba(255,255,255,0.2);
}

.rules-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}

.rules-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-color);
  margin-bottom: 24rpx;
}

.rule-item {
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 2;
  padding-left: 8rpx;
}

.start-section {
  padding-top: 40rpx;
}

.start-btn {
  width: 100%;
  height: 96rpx;
  background: var(--primary);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 96rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}
