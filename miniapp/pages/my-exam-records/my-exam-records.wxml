<!--pages/my-exam-records/my-exam-records.wxml-->
<view class="page page-fade-in">
  <view class="list" wx:if="{{records.length > 0}}">
    <view wx:for="{{records}}" wx:key="id" class="record-item" bindtap="goDetail" data-id="{{item.id}}">
      <view class="record-left">
        <view class="record-title text-ellipsis">{{item.paperName || item.examName || item.examTitle || '考试'}}</view>
        <view class="record-time">{{item.createTime || item.examTime || ''}}</view>
      </view>
      <view class="record-right">
        <text class="record-score {{item.passed ? 'passed' : 'failed'}}">{{item.score || 0}}分</text>
        <text class="record-status">{{item.passed ? '通过' : '未通过'}}</text>
      </view>
    </view>
  </view>
  <view wx:else class="empty-wrap"><text class="empty-text">暂无考试记录</text></view>
<qa-float-btn />
</view>
