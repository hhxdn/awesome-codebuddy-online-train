<!--pages/qa-submit/qa-submit.wxml-->
<view class="qa-submit-page page-fade-in">
  <view class="qa-content">
    <view class="qa-intro">
      <text class="qa-intro-text">😊 有问题随时问，我们将尽快回复您</text>
    </view>

    <view class="form-group">
      <!-- 问题描述 -->
      <view class="form-label">问题描述 <text class="required">*</text></view>
      <textarea
        class="form-textarea"
        value="{{content}}"
        placeholder="请详细描述您的问题"
        maxlength="500"
        bindinput="onContentInput"
      />

      <!-- 图片上传 -->
      <view class="form-label">上传图片（可选）</view>
      <view class="upload-grid">
        <view wx:for="{{images}}" wx:key="*this" class="upload-item">
          <image src="{{item}}" mode="aspectFill" class="upload-img" />
          <view class="upload-remove" bindtap="removeImage" data-index="{{index}}">✕</view>
        </view>
        <view wx:if="{{images.length < 6}}" class="upload-btn" bindtap="chooseImage">
          <text class="upload-icon">+</text>
        </view>
      </view>
      <view class="upload-tip">支持 jpg、png 格式，最多6张</view>

      <!-- 手机号 -->
      <view class="form-label">手机号 <text class="required">*</text></view>
      <input
        class="form-input"
        type="number"
        maxlength="11"
        value="{{phone}}"
        placeholder="请输入手机号"
        bindinput="onPhoneInput"
      />
    </view>

    <view class="submit-btn-wrap">
      <button class="submit-btn" bindtap="handleSubmit" loading="{{submitting}}" disabled="{{submitting}}">
        提交问题
      </button>
    </view>
  </view>
</view>
