<!--pages/practice-courses/practice-courses.wxml-->
<view class="practice-courses-page page-fade-in">
  <view class="page-header">
    <text class="header-title">我的练习</text>
    <text class="header-desc">选择课程开始练习</text>
  </view>

  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="loading-center">
    <view class="loading-dot"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 暂无练习题课程 -->
  <view wx:elif="{{courses.length === 0}}" class="empty-state">
    <text class="empty-icon">📝</text>
    <text class="empty-title">暂无练习题</text>
    <text class="empty-desc">目前还没有上架包含练习题的课程，请耐心等待</text>
    <button class="browse-btn" bindtap="goBrowseCourses">浏览课程</button>
  </view>

  <!-- 课程列表 -->
  <view wx:else class="course-list">
    <view wx:for="{{courses}}" wx:key="courseId" class="course-card" bindtap="goCourse" data-id="{{item.courseId}}">
      <view class="card-cover">
        <image src="{{item.courseCover || 'https://picsum.photos/seed/practice/480/270'}}" mode="aspectFill" class="cover-img" />
        <view wx:if="{{item.price && item.price > 0}}" class="cover-badge">付费</view>
      </view>
      <view class="card-body">
        <text class="card-title text-ellipsis">{{item.courseTitle}}</text>
        <view class="card-stats">
          <text class="stat-item">📚 {{item.chapterCount}}个章节</text>
          <text class="stat-item">📄 {{item.questionCount}}道题目</text>
        </view>
      </view>
      <text class="card-arrow">›</text>
    </view>
  </view>
<qa-float-btn />
</view>
