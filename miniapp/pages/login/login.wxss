/* pages/login/login.wxss */
.login-page {
  min-height: 100vh;
  position: relative;
  overflow: hidden;
}

.login-bg {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(160deg, #003CAB 0%, #0052D9 40%, #366EF4 100%);
  z-index: 0;
}

.bg-blur {
  position: absolute;
  border-radius: 50%;
  background: rgba(255,255,255,0.05);
}

.b1 { width: 520rpx; height: 520rpx; top: -160rpx; right: -120rpx; }
.b2 { width: 320rpx; height: 320rpx; bottom: 10%; left: -80rpx; }

.login-content {
  position: relative;
  z-index: 1;
  padding: 112rpx 40rpx 80rpx;
}

.login-brand {
  text-align: center;
  margin-bottom: 80rpx;
}

.brand-icon {
  margin-bottom: 28rpx;
}

.app-name {
  font-size: 52rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 2rpx;
}

.app-desc {
  font-size: 28rpx;
  color: rgba(255,255,255,0.6);
  margin-top: 12rpx;
}

.login-card {
  background: #fff;
  border-radius: 32rpx;
  padding-bottom: 8rpx;
  box-shadow: 0 24rpx 80rpx rgba(0,0,0,0.1);
  overflow: hidden;
}

.card-tabs {
  display: flex;
  padding: 40rpx 40rpx 0;
  gap: 40rpx;
}

.tab {
  font-size: 34rpx;
  font-weight: 500;
  color: var(--text-muted);
  padding-bottom: 20rpx;
  position: relative;
}

.tab.active {
  color: var(--text-color);
  font-weight: 700;
}

.tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  border-radius: 4rpx;
  background: var(--primary);
}

.form-wrap {
  padding: 20rpx 0 0;
}

.form-group {
  padding: 0 40rpx;
}

.form-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}

.form-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.form-input {
  flex: 1;
  font-size: 30rpx;
  color: var(--text-color);
}

.form-action {
  padding: 56rpx 40rpx;
}

.action-btn {
  width: 100%;
  height: 96rpx;
  background: var(--primary);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  border-radius: 96rpx;
  border: none;
  box-shadow: 0 8rpx 32rpx rgba(0,82,217,0.3);
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-btn:active {
  transform: scale(0.98);
}

.login-agreement {
  text-align: center;
  margin-top: 48rpx;
  font-size: 24rpx;
  color: rgba(255,255,255,0.5);
}

.agreement-link {
  color: rgba(255,255,255,0.7);
}
