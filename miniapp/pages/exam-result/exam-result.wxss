/* pages/exam-result/exam-result.wxss */
.result-page {
  min-height: 100vh;
  background: var(--bg-color);
  padding-bottom: 200rpx;
}

.result-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0 40rpx;
}

.score-circle {
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
  border: 8rpx solid transparent;
}

.score-circle.passed {
  background: linear-gradient(135deg, #00A870, #008858);
  border-color: #00A870;
}

.score-circle.failed {
  background: linear-gradient(135deg, #E34D59, #C9353F);
  border-color: #E34D59;
}

.score-value {
  font-size: 72rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1;
}

.score-label {
  font-size: 28rpx;
  color: rgba(255,255,255,0.8);
}

.result-msg {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-color);
  margin-bottom: 16rpx;
}

.result-stats {
  display: flex;
  gap: 32rpx;
}

.stat-text {
  font-size: 28rpx;
  color: var(--text-muted);
}

/* Review */
.review-card {
  background: #fff;
  margin: 24rpx;
  border-radius: 24rpx;
  padding: 36rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}

.review-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-color);
  margin-bottom: 32rpx;
}

.review-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border-light);
}

.review-item:last-child {
  border-bottom: none;
}

.review-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.review-num {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--primary);
}

.review-type-tag {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  background: var(--bg-color);
  color: var(--text-muted);
}

.review-result {
  font-size: 24rpx;
  font-weight: 600;
  margin-left: auto;
}

.review-result.correct { color: var(--success); }
.review-result.wrong { color: var(--danger); }

.review-content {
  font-size: 28rpx;
  color: var(--text-color);
  line-height: 1.7;
  margin-bottom: 16rpx;
}

.review-answer {
  font-size: 26rpx;
  margin-bottom: 8rpx;
}

.answer-label {
  color: var(--text-muted);
}

.answer-value {
  font-weight: 500;
}

.text-correct { color: var(--success); }
.text-wrong { color: var(--danger); }

.review-analysis {
  font-size: 26rpx;
  margin-top: 12rpx;
  padding: 16rpx;
  background: var(--bg-color);
  border-radius: 12rpx;
}

.analysis-label {
  color: var(--primary);
  font-weight: 500;
}

.analysis-text {
  color: var(--text-secondary);
}

/* Actions */
.result-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 32rpx;
  display: flex;
  gap: 24rpx;
  background: #fff;
  box-shadow: 0 -4rpx 24rpx rgba(0,0,0,0.06);
}

.action-btn-secondary {
  flex: 1;
  height: 88rpx;
  background: var(--bg-color);
  color: var(--text-secondary);
  font-size: 28rpx;
  border-radius: 88rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-btn-primary {
  flex: 1;
  height: 88rpx;
  background: var(--primary);
  color: #fff;
  font-size: 28rpx;
  border-radius: 88rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}
