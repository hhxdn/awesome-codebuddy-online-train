.page{min-height:100vh;background:var(--bg-color);padding:24rpx 24rpx 160rpx}.item{background:#fff;border-radius:20rpx;padding:32rpx;margin-bottom:20rpx;box-shadow:0 4rpx 16rpx rgba(0,0,0,0.04)}.item-header{display:flex;align-items:center;gap:16rpx;margin-bottom:16rpx}.item-type{padding:4rpx 16rpx;border-radius:6rpx;font-size:22rpx;font-weight:500}.type-SINGLE{background:var(--primary-bg);color:var(--primary)}.type-MULTIPLE{background:#FFF3E8;color:var(--warning)}.type-JUDGE{background:#E6F9EE;color:var(--success)}.type-ESSAY{background:var(--bg-color);color:var(--text-muted)}.item-course{font-size:22rpx;color:var(--text-muted)}.item-content{font-size:28rpx;color:var(--text-color);line-height:1.7;margin-bottom:20rpx}.item-answer{margin-bottom:8rpx}.label{font-size:24rpx;color:var(--text-muted)}.value{font-size:26rpx;font-weight:500}.wrong{color:var(--danger)}.correct{color:var(--success)}.clear-section{padding:40rpx 0}.clear-btn{width:100%;height:88rpx;background:transparent;color:var(--danger);border:2rpx solid var(--danger);border-radius:88rpx;font-size:28rpx;display:flex;align-items:center;justify-content:center}