.search-page{min-height:100vh;background:var(--bg-color)}.search-bar{display:flex;align-items:center;gap:20rpx;padding:20rpx 32rpx;background:#fff}.search-box{flex:1;display:flex;align-items:center;gap:16rpx;background:var(--bg-color);border-radius:16rpx;padding:16rpx 24rpx}.search-icon{font-size:28rpx}.search-input{flex:1;font-size:28rpx}.search-clear{font-size:28rpx;color:var(--text-muted);padding:4rpx}.search-cancel{font-size:28rpx;color:var(--text-secondary);flex-shrink:0}.result-scroll{padding:24rpx}.result-item{background:#fff;border-radius:20rpx;padding:32rpx;margin-bottom:20rpx;box-shadow:0 4rpx 16rpx rgba(0,0,0,0.04)}.result-title{font-size:30rpx;font-weight:500;color:var(--text-color);display:block;margin-bottom:12rpx}.result-cat{font-size:24rpx;color:var(--text-muted)}.hot-section{padding:40rpx 32rpx}.hot-title{font-size:30rpx;font-weight:600;color:var(--text-color);margin-bottom:24rpx}.hot-tags{display:flex;flex-wrap:wrap;gap:16rpx}.hot-tag{padding:14rpx 28rpx;background:#fff;border-radius:32rpx;font-size:26rpx;color:var(--text-secondary);box-shadow:0 2rpx 8rpx rgba(0,0,0,0.04)}