/* pages/index/index.wxss */
.splash {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(160deg, #003CAB, #0052D9 40%, #366EF4);
}

.splash-icon {
  margin-bottom: 28rpx;
}

.splash-name {
  font-size: 44rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 2rpx;
}
