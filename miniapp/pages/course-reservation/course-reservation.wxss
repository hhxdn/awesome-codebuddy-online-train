/* pages/course-reservation/course-reservation.wxss */
.reservation-page {
  background: var(--bg-color);
  min-height: 100vh;
  padding-bottom: 80rpx;
}

.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 240rpx;
  gap: 20rpx;
}

.loading-dot {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid var(--primary-bg);
  border-top-color: var(--primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: var(--text-muted);
}

.course-info-card {
  background: #fff;
  margin: 24rpx 28rpx;
  padding: 48rpx 36rpx;
  border-radius: 24rpx;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.03);
}

.course-cover {
  width: 100%;
  height: 960rpx;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 28rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
}

.cover-img {
  width: 100%;
  height: 100%;
}

.cover-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cover-icon {
  font-size: 64rpx;
}

.course-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-color);
  display: block;
  margin-bottom: 16rpx;
}

.course-desc {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.6;
  display: block;
  text-align: left;
  margin-bottom: 24rpx;
}

.course-notice {
  background: #FFF3E0;
  border-radius: 16rpx;
  padding: 20rpx 28rpx;
  font-size: 26rpx;
  color: #E37318;
  text-align: left;
}

.status-card {
  background: #fff;
  margin: 24rpx 28rpx;
  padding: 36rpx;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.03);
}

.status-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.dot-pending { background: #E6A23C; }
.dot-confirmed { background: #67C23A; }
.dot-completed { background: #409EFF; }

.status-label {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-color);
}

.status-detail {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
}

.status-action {
  margin-top: 24rpx;
}

.cancel-btn {
  width: 200rpx;
  height: 64rpx;
  font-size: 26rpx;
  color: var(--text-muted);
  border: 2rpx solid var(--border-color);
  border-radius: 32rpx;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.reservation-form {
  margin-top: 24rpx;
}

.form-group {
  background: #fff;
  margin: 0 28rpx;
  border-radius: 24rpx;
  overflow: hidden;
}

.form-item {
  padding: 0 32rpx;
  border-bottom: 1rpx solid var(--border-light);
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  font-size: 28rpx;
  color: var(--text-color);
  padding: 32rpx 0 12rpx;
  display: block;
}

.form-picker {
  height: 60rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 28rpx;
  color: var(--text-color);
}

.form-picker.placeholder {
  color: var(--text-placeholder);
}

.picker-arrow {
  font-size: 40rpx;
  color: var(--text-placeholder);
  transform: rotate(90deg);
}

.form-textarea {
  width: 100%;
  height: 160rpx;
  font-size: 28rpx;
  padding-bottom: 28rpx;
}

.form-action {
  padding: 48rpx 32rpx;
}

.reserve-btn {
  width: 100%;
  height: 96rpx;
  background: var(--primary);
  color: #fff;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}
