/* pages/my-certificates/my-certificates.wxss */

.page {
  min-height: 100vh;
  background: #f7f8fa;
  padding-bottom: env(safe-area-inset-bottom);
}

/* 加载状态 */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.loading-spinner {
  width: 56rpx;
  height: 56rpx;
  border: 4rpx solid #E5E5E5;
  border-top-color: #0052D9;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: #969799;
}

/* 空状态 */
.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 96rpx;
  opacity: 0.4;
}

.empty-text {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #969799;
}

/* 证书列表 */
.cert-list {
  padding: 24rpx;
}

.cert-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  transition: transform 0.2s;
}

.cert-card:active {
  transform: scale(0.98);
}

.cert-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.cert-icon {
  font-size: 52rpx;
}

.cert-info {
  flex: 1;
  overflow: hidden;
}

.cert-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #323233;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cert-course {
  display: block;
  font-size: 24rpx;
  color: #969799;
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cert-arrow {
  font-size: 40rpx;
  color: #C9CDD4;
  flex-shrink: 0;
}

.cert-footer {
  display: flex;
  justify-content: space-between;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f5f5f5;
}

.cert-no {
  font-size: 22rpx;
  color: #C9CDD4;
}

.cert-time {
  font-size: 22rpx;
  color: #969799;
}

/* 详情弹窗遮罩 */
.overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  animation: fadeIn 0.25s ease;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.detail-panel {
  width: 100%;
  max-height: 85vh;
  background: #f7f8fa;
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 32rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  overflow-y: auto;
  animation: slideUp 0.3s ease;
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

/* 详情卡片 */
.detail-card {
  background: linear-gradient(135deg, #FFF7E6 0%, #FFF 100%);
  border: 3rpx solid #E37318;
  border-radius: 24rpx;
  padding: 48rpx 36rpx;
  text-align: center;
  position: relative;
  overflow: hidden;
}

.detail-badge {
  display: inline-block;
  background: #E37318;
  color: #fff;
  padding: 6rpx 40rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}

.detail-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #323233;
  margin-bottom: 16rpx;
}

.detail-desc {
  display: block;
  font-size: 28rpx;
  color: #646566;
  line-height: 1.8;
  margin-bottom: 32rpx;
}

.detail-meta {
  text-align: left;
  font-size: 26rpx;
  color: #646566;
}

.meta-item {
  margin: 10rpx 0;
  line-height: 1.6;
}

.meta-label {
  font-weight: 600;
  color: #323233;
}

/* 印章 */
.detail-seal {
  position: absolute;
  bottom: 60rpx;
  right: 50rpx;
  width: 120rpx;
  height: 120rpx;
  border: 4rpx solid #E34D59;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #E34D59;
  font-size: 22rpx;
  font-weight: bold;
  transform: rotate(-15deg);
  opacity: 0.7;
  text-align: center;
  line-height: 1.3;
}

/* 按钮 */
.download-btn {
  margin-top: 24rpx;
  height: 88rpx;
  border-radius: 44rpx;
  background: #07C160 !important;
  color: #fff !important;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.close-btn {
  margin-top: 20rpx;
  height: 88rpx;
  border-radius: 44rpx;
  background: #0052D9 !important;
  color: #fff !important;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}
