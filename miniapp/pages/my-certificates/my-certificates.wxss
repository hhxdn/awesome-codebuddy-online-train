.page{min-height:100vh;background:var(--bg-color);padding:24rpx}.cert-item{display:flex;align-items:center;gap:24rpx;background:#fff;border-radius:20rpx;padding:32rpx;margin-bottom:20rpx;box-shadow:0 4rpx 16rpx rgba(0,0,0,0.04)}.cert-icon{font-size:52rpx}.cert-info{flex:1}.cert-title{font-size:30rpx;font-weight:500;color:var(--text-color);margin-bottom:8rpx}.cert-date{font-size:24rpx;color:var(--text-muted)}.cert-arrow{font-size:40rpx;color:var(--text-placeholder)}