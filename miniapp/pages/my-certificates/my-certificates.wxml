<!--pages/my-certificates/my-certificates.wxml-->
<view class="page">

  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading-wrap">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 空状态 -->
  <view wx:elif="{{certificates.length === 0}}" class="empty-wrap">
    <view class="empty-icon">📄</view>
    <text class="empty-text">暂无结业证书</text>
  </view>

  <!-- 证书列表 -->
  <view wx:else class="cert-list">
    <view wx:for="{{certificates}}" wx:key="id" class="cert-card" bindtap="viewDetail" data-item="{{item}}">
      <view class="cert-header">
        <text class="cert-icon">🎓</text>
        <view class="cert-info">
          <text class="cert-title">{{item.title}}</text>
          <text class="cert-course">{{item.courseTitle}}</text>
        </view>
        <text class="cert-arrow">›</text>
      </view>
      <view class="cert-footer">
        <text class="cert-no">编号: {{item.certNo}}</text>
        <text class="cert-time">{{item._issueTime}}</text>
      </view>
    </view>
  </view>

  <!-- 证书详情弹窗 -->
  <view wx:if="{{showDetail && currentCert}}" class="overlay" catchtouchmove="preventTouchMove" bindtap="closeDetail">
    <view class="detail-panel" catchtap="noop">
      <!-- 详情卡片 -->
      <view class="detail-card">
        <view class="detail-badge">结业证书</view>
        <text class="detail-title">{{currentCert.title}}</text>
        <text class="detail-desc">{{currentCert.content}}</text>
        <view class="detail-meta">
          <view class="meta-item"><text class="meta-label">证书编号：</text><text>{{currentCert.certNo}}</text></view>
          <view class="meta-item"><text class="meta-label">颁发时间：</text><text>{{currentCert._issueTime}}</text></view>
          <view class="meta-item"><text class="meta-label">课程：</text><text>{{currentCert.courseTitle}}</text></view>
          <view class="meta-item" wx:if="{{currentCert.examRecordId}}"><text class="meta-label">考试记录ID：</text><text>{{currentCert.examRecordId}}</text></view>
        </view>
        <view class="detail-seal">线下考试通过</view>
      </view>
      <!-- 下载附件按钮 -->
      <button wx:if="{{currentCert.attachmentUrl}}" class="download-btn" bindtap="downloadAttachment">下载证书附件</button>
      <!-- 关闭按钮 -->
      <button class="close-btn" bindtap="closeDetail">关闭</button>
    </view>
  </view>

</view>
