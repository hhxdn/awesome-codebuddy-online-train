<!--pages/my-certificates/my-certificates.wxml-->
<view class="page page-fade-in">
  <view class="list" wx:if="{{certificates.length > 0}}">
    <view wx:for="{{certificates}}" wx:key="id" class="cert-item" bindtap="showDetail" data-item="{{item}}">
      <view class="cert-icon">🎓</view>
      <view class="cert-info">
        <view class="cert-title">{{item.title || item.name}}</view>
        <view class="cert-date">{{item.issueDate || item.createTime || ''}}</view>
      </view>
      <text class="cert-arrow">›</text>
    </view>
  </view>
  <view wx:else class="empty-wrap"><text class="empty-text">暂无证书</text></view>
</view>
