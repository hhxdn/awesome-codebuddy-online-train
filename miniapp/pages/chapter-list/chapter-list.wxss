.page{min-height:100vh;background:var(--bg-color)}.course-header{background:linear-gradient(135deg,var(--primary),var(--primary-light));padding:40rpx 32rpx;color:#fff}.course-title{font-size:36rpx;font-weight:700;margin-bottom:24rpx}.progress-bar{height:10rpx;background:rgba(255,255,255,0.3);border-radius:5rpx;overflow:hidden;margin-bottom:12rpx}.progress-fill{height:100%;background:#fff;border-radius:5rpx}.progress-text{font-size:24rpx;color:rgba(255,255,255,0.8)}.list{padding:24rpx}.chapter-item{display:flex;align-items:center;gap:24rpx;background:#fff;border-radius:20rpx;padding:28rpx;margin-bottom:16rpx;box-shadow:0 4rpx 16rpx rgba(0,0,0,0.04)}.chapter-num{width:64rpx;height:64rpx;border-radius:16rpx;background:var(--primary-bg);color:var(--primary);display:flex;align-items:center;justify-content:center;font-size:26rpx;font-weight:600;flex-shrink:0;font-family:monospace}.chapter-num.done{background:var(--success);color:#fff;font-size:32rpx}.chapter-info{flex:1;min-width:0}.chapter-name{font-size:28rpx;color:var(--text-color);margin-bottom:8rpx}.chapter-bottom{display:flex;align-items:center;gap:24rpx}.chapter-dur{font-size:24rpx;color:var(--text-muted)}.chapter-done{font-size:24rpx;color:var(--success)}.practice-btn{font-size:24rpx;color:var(--primary);background:var(--primary-bg);border:none;border-radius:48rpx;padding:8rpx 24rpx}.trial-tag{display:inline-block;font-size:20rpx;color:#fff;background:linear-gradient(135deg,#FF9800,#F57C00);padding:2rpx 10rpx;border-radius:6rpx;margin-left:8rpx;vertical-align:middle;font-weight:500}.lock-icon{font-size:32rpx}