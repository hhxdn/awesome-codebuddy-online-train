/* pages/mine/mine.wxss */
.mine-page {
  min-height: 100vh;
  background: var(--bg-color);
}

/* Header */
.mine-header {
  position: relative;
  padding-top: env(safe-area-inset-top);
}

.header-bg {
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 360rpx;
  background: linear-gradient(160deg, #003CAB, #0052D9 40%, #366EF4);
}

.bg-blur {
  position: absolute;
  border-radius: 50%;
  background: rgba(255,255,255,0.05);
}

.b1 { width: 520rpx; height: 520rpx; top: -200rpx; right: -120rpx; }
.b2 { width: 320rpx; height: 320rpx; bottom: -60rpx; left: -80rpx; }

.header-content {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx 60rpx;
}

.avatar-wrap {
  margin-bottom: 24rpx;
}

.avatar {
  width: 136rpx;
  height: 136rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.2);
  border: 6rpx solid rgba(255,255,255,0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  font-weight: 700;
  color: #fff;
}

.user-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 8rpx;
}

.user-phone {
  font-size: 26rpx;
  color: rgba(255,255,255,0.6);
}

/* Stats */
.stats-card {
  display: flex;
  background: #fff;
  margin: -30rpx 24rpx 24rpx;
  border-radius: 24rpx;
  padding: 36rpx 0;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.06);
  position: relative;
  z-index: 2;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 44rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.stat-blue { color: var(--primary); }
.stat-green { color: var(--success); }
.stat-orange { color: var(--warning); }

.stat-label {
  font-size: 24rpx;
  color: var(--text-muted);
}

.stat-divider {
  width: 2rpx;
  height: 60rpx;
  background: var(--border-light);
  align-self: center;
}

/* Menu */
.menu-group {
  background: #fff;
  margin: 0 24rpx 24rpx;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.menu-group-title {
  font-size: 26rpx;
  color: var(--text-muted);
  padding: 28rpx 36rpx 16rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 36rpx;
  border-bottom: 1rpx solid var(--border-light);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background: var(--bg-color);
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 24rpx;
}

.menu-text {
  flex: 1;
  font-size: 30rpx;
  color: var(--text-color);
}

.menu-arrow {
  font-size: 36rpx;
  color: var(--text-placeholder);
  font-weight: 300;
}

/* Logout */
.logout-section {
  padding: 60rpx 24rpx;
}

.logout-btn {
  width: 100%;
  height: 88rpx;
  background: transparent;
  color: var(--danger);
  font-size: 30rpx;
  border: 2rpx solid var(--danger);
  border-radius: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
