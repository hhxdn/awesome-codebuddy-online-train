/* pages/enroll/enroll.wxss */
.enroll-page {
  min-height: 100vh;
  background: #f7f8fa;
  padding-bottom: 80rpx;
}

.page-header {
  background: linear-gradient(160deg, #003CAB 0%, #0052D9 40%, #366EF4 100%);
  padding: 48rpx 40rpx 56rpx;
}

.header-content {
  padding-left: 40rpx;
  padding-top: 8rpx;
}

.header-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #fff;
  display: block;
}

.header-subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 16rpx;
  display: block;
}

.conditions-card {
  background: #fff;
  margin: 32rpx;
  padding: 48rpx;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.conditions-content {
  font-size: 30rpx;
  color: #1D2129;
  line-height: 2;
  white-space: pre-line;
}

.step-action {
  padding: 56rpx 40rpx;
}

.action-btn {
  width: 100%;
  height: 96rpx;
  background: var(--primary);
  color: #fff;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(0, 82, 217, 0.3);
}

.form-container {
  padding-top: 32rpx;
}

.form-group {
  background: #fff;
  margin: 0 32rpx;
  border-radius: 24rpx;
  overflow: hidden;
}

.form-item {
  padding: 0 32rpx;
  border-bottom: 1rpx solid var(--border-light);
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  font-size: 28rpx;
  color: var(--text-color);
  padding: 32rpx 0 12rpx;
  display: block;
}

.form-input {
  width: 100%;
  height: 60rpx;
  font-size: 28rpx;
  padding-bottom: 28rpx;
}

.form-picker {
  height: 60rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 28rpx;
  color: var(--text-color);
}

.form-picker.placeholder {
  color: var(--text-placeholder);
}

.picker-arrow {
  font-size: 40rpx;
  color: var(--text-placeholder);
  transform: rotate(90deg);
}

.form-action {
  padding: 56rpx 40rpx;
}

.submit-btn {
  width: 100%;
  height: 96rpx;
  background: var(--primary);
  color: #fff;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(0, 82, 217, 0.3);
}
