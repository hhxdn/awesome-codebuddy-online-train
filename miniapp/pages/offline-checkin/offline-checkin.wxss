.page{min-height:100vh;background:var(--bg-color);padding:24rpx}.info-card{background:#fff;border-radius:24rpx;padding:60rpx 40rpx;text-align:center;box-shadow:0 4rpx 16rpx rgba(0,0,0,0.04);margin-bottom:24rpx}.info-icon{font-size:80rpx;margin-bottom:20rpx}.info-title{font-size:36rpx;font-weight:700;color:var(--text-color);margin-bottom:16rpx}.info-desc{font-size:28rpx;color:var(--text-muted)}.location-card{background:#fff;border-radius:24rpx;padding:36rpx;margin-bottom:24rpx;box-shadow:0 4rpx 16rpx rgba(0,0,0,0.04)}.location-item{display:flex;justify-content:space-between;padding:20rpx 0;border-bottom:1rpx solid var(--border-light)}.loc-label{font-size:28rpx;color:var(--text-secondary)}.loc-value{font-size:28rpx;color:var(--text-color);font-family:monospace}.location-status{text-align:center;padding-top:24rpx;font-size:30rpx;font-weight:600}.in-range{color:var(--success)}.out-range{color:var(--danger)}.action-section{display:flex;flex-direction:column;gap:24rpx;padding:40rpx 0}.locate-btn{width:100%;height:96rpx;background:var(--bg-color);color:var(--text-secondary);font-size:30rpx;border-radius:96rpx;border:none;display:flex;align-items:center;justify-content:center}.checkin-btn{width:100%;height:96rpx;background:linear-gradient(135deg,#ED7B2F,#E37318);color:#fff;font-size:32rpx;font-weight:600;border-radius:96rpx;border:none;display:flex;align-items:center;justify-content:center}.checkin-btn[disabled]{background:var(--bg-color);color:var(--text-muted)}