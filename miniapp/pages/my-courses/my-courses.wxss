.page{min-height:100vh;background:var(--bg-color);padding:24rpx}.course-item{display:flex;gap:24rpx;background:#fff;border-radius:20rpx;padding:24rpx;margin-bottom:20rpx;box-shadow:0 4rpx 16rpx rgba(0,0,0,0.04)}.course-cover{width:120rpx;height:454rpx;border-radius:12rpx}.course-cover-placeholder{width:120rpx;height:454rpx;border-radius:12rpx;background:var(--primary-bg);display:flex;align-items:center;justify-content:center}.cover-letter{font-size:52rpx;color:rgba(0,82,217,0.2);font-weight:700}.course-info{flex:1;display:flex;flex-direction:column;justify-content:center}.course-title{font-size:28rpx;font-weight:500;color:var(--text-color);margin-bottom:12rpx}.progress-bar{height:8rpx;background:var(--border-color);border-radius:4rpx;overflow:hidden;margin-bottom:8rpx}.progress-fill{height:100%;background:var(--primary);border-radius:4rpx}.progress-text{font-size:22rpx;color:var(--text-muted)}