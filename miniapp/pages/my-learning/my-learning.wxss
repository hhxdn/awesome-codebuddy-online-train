.page{min-height:100vh;background:var(--bg-color);padding:24rpx}.record-item{display:flex;align-items:center;background:#fff;border-radius:20rpx;padding:32rpx;margin-bottom:20rpx;box-shadow:0 4rpx 16rpx rgba(0,0,0,0.04)}.record-left{flex:1;min-width:0}.record-title{font-size:30rpx;font-weight:500;color:var(--text-color);margin-bottom:8rpx}.record-time{font-size:24rpx;color:var(--text-muted)}.record-right{margin-left:20rpx}.record-dur{font-size:32rpx;font-weight:600;color:var(--primary)}