.page{min-height:100vh;background:var(--bg-color);padding:24rpx}.record-item{display:flex;align-items:flex-start;background:#fff;border-radius:20rpx;padding:24rpx;margin-bottom:20rpx;box-shadow:0 4rpx 16rpx rgba(0,0,0,0.04);position:relative}.record-cover{width:100rpx;height:378rpx;border-radius:12rpx;margin-right:20rpx;flex-shrink:0;background:#f0f0f0}.record-body{flex:1;min-width:0}.record-title{font-size:30rpx;font-weight:500;color:var(--text-color);margin-bottom:6rpx}.record-time{font-size:22rpx;color:var(--text-muted);margin-bottom:10rpx}.progress-bar-wrap{display:flex;align-items:center;gap:12rpx;margin-bottom:8rpx}.progress-bar-bg{flex:1;height:10rpx;background:#e8e8e8;border-radius:5rpx;overflow:hidden}.progress-bar-fill{height:100%;background:linear-gradient(90deg,var(--primary),#6c8aff);border-radius:5rpx;transition:width 0.3s}.progress-text{font-size:22rpx;color:var(--primary);font-weight:600;min-width:50rpx}.record-stats{display:flex;gap:24rpx;font-size:22rpx;color:var(--text-muted)}.record-arrow{font-size:36rpx;color:#ccc;margin-left:12rpx;margin-top:30rpx}
