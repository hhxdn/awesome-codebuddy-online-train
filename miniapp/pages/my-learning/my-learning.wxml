<!--pages/my-learning/my-learning.wxml-->
<view class="page page-fade-in">
  <view class="list" wx:if="{{records.length > 0}}">
    <view wx:for="{{records}}" wx:key="id" class="record-item">
      <view class="record-left">
        <view class="record-title text-ellipsis">{{item.chapterName || item.courseName || '学习记录'}}</view>
        <view class="record-time">{{item.createTime || ''}}</view>
      </view>
      <view class="record-right">
        <text class="record-dur">{{item.duration || item.studyTime || '--'}}</text>
      </view>
    </view>
  </view>
  <view wx:else class="empty-wrap"><text class="empty-text">暂无学习记录</text></view>
<qa-float-btn />
</view>
