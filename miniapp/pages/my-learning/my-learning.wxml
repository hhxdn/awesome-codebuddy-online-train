<!--pages/my-learning/my-learning.wxml-->
<view class="page page-fade-in">
  <view class="list" wx:if="{{records.length > 0}}">
    <view wx:for="{{records}}" wx:key="courseId" class="record-item" bindtap="goCourseDetail" data-id="{{item.courseId}}">
      <image wx:if="{{item.courseCover}}" class="record-cover" src="{{item.courseCover}}" mode="aspectFill" />
      <view class="record-body">
        <view class="record-title text-ellipsis">{{item.courseTitle || item.courseName || '学习记录'}}</view>
        <view class="record-time">{{item.createTime || item.lastStudyTime || ''}}</view>
        <view class="progress-bar-wrap">
          <view class="progress-bar-bg">
            <view class="progress-bar-fill" style="width: {{item.progress || 0}}%"></view>
          </view>
          <text class="progress-text">{{item.progress || 0}}%</text>
        </view>
        <view class="record-stats">
          <text>已学 {{item.studiedChapters || 0}}/{{item.totalChapters || 0}} 节</text>
          <text>学习 {{item.duration || item.totalDuration || 0}} 分钟</text>
        </view>
      </view>
      <view class="record-arrow">›</view>
    </view>
  </view>
  <view wx:else class="empty-wrap"><text class="empty-text">暂无学习记录</text></view>
<qa-float-btn />
</view>
