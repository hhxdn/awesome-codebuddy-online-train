.page{min-height:100vh;background:var(--bg-color);padding:24rpx}.approval-card{background:#fff;border-radius:24rpx;padding:60rpx 40rpx;text-align:center;box-shadow:0 4rpx 16rpx rgba(0,0,0,0.04);margin-bottom:24rpx}.approval-icon{font-size:100rpx;margin-bottom:24rpx}.approval-title{font-size:36rpx;font-weight:700;color:var(--text-color);margin-bottom:16rpx}.approval-desc{font-size:28rpx;color:var(--text-muted);line-height:1.8;margin-bottom:48rpx}.steps{display:flex;align-items:center;justify-content:center}.step{display:flex;flex-direction:column;align-items:center;gap:8rpx;font-size:22rpx;color:var(--text-muted)}.step-dot{width:56rpx;height:56rpx;border-radius:50%;background:var(--bg-color);color:var(--text-muted);display:flex;align-items:center;justify-content:center;font-size:24rpx;font-weight:600}.step.done .step-dot{background:var(--success);color:#fff}.step.active .step-dot{background:var(--primary);color:#fff}.step.rejected .step-dot{background:var(--danger);color:#fff}.step-line{width:80rpx;height:4rpx;background:var(--border-color);margin:0 -4rpx 28rpx}.step-line.done{background:var(--success)}.action-section{display:flex;flex-direction:column;gap:24rpx;padding:40rpx 0}.action-btn{width:100%;height:96rpx;background:var(--primary);color:#fff;font-size:32rpx;font-weight:600;border-radius:96rpx;border:none;display:flex;align-items:center;justify-content:center}.refresh-btn{width:100%;height:96rpx;background:var(--bg-color);color:var(--text-secondary);font-size:30rpx;border-radius:96rpx;border:none;display:flex;align-items:center;justify-content:center}