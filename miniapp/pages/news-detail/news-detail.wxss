/* pages/news-detail/news-detail.wxss */
.news-detail-page {
  min-height: 100vh;
  background: #fff;
}

.detail-content {
  padding: 40rpx 32rpx 80rpx;
}

.detail-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1D2129;
  line-height: 1.4;
  margin-bottom: 24rpx;
}

.detail-meta {
  display: flex;
  gap: 28rpx;
  font-size: 24rpx;
  color: #86909C;
  margin-bottom: 32rpx;
}

.detail-cover {
  width: 100%;
  border-radius: 16rpx;
  margin-bottom: 40rpx;
}

.detail-body {
  font-size: 30rpx;
  color: #4E5969;
  line-height: 1.8;
}

.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
  gap: 20rpx;
}

.loading-dot {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid var(--primary-bg);
  border-top-color: var(--primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: var(--text-muted);
}
