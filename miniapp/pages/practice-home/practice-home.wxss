/* pages/practice-home/practice-home.wxss */
.practice-home {
  min-height: 100vh;
  background: var(--bg-color);
  padding: 24rpx;
}

.stats-card {
  background: linear-gradient(135deg, var(--primary), var(--primary-light));
  border-radius: 24rpx;
  padding: 40rpx;
  margin-bottom: 24rpx;
}

.stats-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  text-align: center;
  margin-bottom: 40rpx;
}

.stats-row {
  display: flex;
  align-items: center;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-value {
  font-size: 44rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: rgba(255,255,255,0.7);
}

.stat-divider {
  width: 2rpx;
  height: 60rpx;
  background: rgba(255,255,255,0.2);
}

.start-section {
  margin-bottom: 24rpx;
}

.start-btn {
  width: 100%;
  height: 96rpx;
  background: var(--primary);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 96rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.history-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}

.history-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-color);
  margin-bottom: 24rpx;
}

.history-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border-light);
}

.history-item:last-child {
  border-bottom: none;
}

.history-left {
  flex: 1;
}

.history-date {
  font-size: 26rpx;
  color: var(--text-color);
  margin-bottom: 4rpx;
}

.history-info {
  font-size: 24rpx;
  color: var(--text-muted);
}

.history-score {
  font-size: 36rpx;
  font-weight: 700;
}

.history-score.passed {
  color: var(--success);
}

.history-score.failed {
  color: var(--danger);
}

/* No Exercise Access */
.no-access-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 60rpx 48rpx;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
  margin-bottom: 24rpx;
}

.no-access-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 24rpx;
}

.no-access-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #E34D59;
  display: block;
  margin-bottom: 16rpx;
}

.no-access-desc {
  font-size: 26rpx;
  color: #86909C;
  line-height: 1.6;
  display: block;
  margin-bottom: 40rpx;
  padding: 0 20rpx;
}

.back-btn {
  width: 280rpx;
  height: 72rpx;
  line-height: 72rpx;
  background: #fff;
  border: 2rpx solid var(--primary);
  color: var(--primary);
  font-size: 28rpx;
  border-radius: 72rpx;
}

.loading-box {
  text-align: center;
  padding: 100rpx 0;
}

.loading-text {
  font-size: 28rpx;
  color: var(--text-muted);
}
