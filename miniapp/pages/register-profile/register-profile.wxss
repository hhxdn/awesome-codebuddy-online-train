.page{min-height:100vh;background:var(--bg-color);padding:24rpx}.header-text{font-size:36rpx;font-weight:700;color:var(--text-color);text-align:center;padding:40rpx 0}.form-card{background:#fff;border-radius:24rpx;padding:8rpx 36rpx;box-shadow:0 4rpx 16rpx rgba(0,0,0,0.04);margin-bottom:24rpx}.form-item{display:flex;align-items:center;padding:28rpx 0;border-bottom:1rpx solid var(--border-light)}.form-item:last-child{border-bottom:none}.label{width:120rpx;font-size:28rpx;color:var(--text-color);flex-shrink:0}.input{flex:1;font-size:28rpx;color:var(--text-color)}.gender-group{display:flex;gap:24rpx}.gender-chip{padding:12rpx 40rpx;border-radius:12rpx;background:var(--bg-color);font-size:28rpx;color:var(--text-secondary)}.gender-chip.active{background:var(--primary-bg);color:var(--primary);font-weight:600}.submit-section{padding:40rpx 0}.submit-btn{width:100%;height:96rpx;background:var(--primary);color:#fff;font-size:32rpx;font-weight:600;border-radius:96rpx;border:none;display:flex;align-items:center;justify-content:center}