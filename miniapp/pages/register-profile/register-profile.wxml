<!--pages/register-profile/register-profile.wxml-->
<view class="page page-fade-in">
  <view class="header-text">完善个人资料</view>
  <view class="form-card">
    <view class="form-item"><text class="label">姓名</text><input class="input" placeholder="请输入真实姓名" value="{{form.realName}}" bindinput="onFieldInput" data-field="realName" /></view>
    <view class="form-item"><text class="label">性别</text>
      <view class="gender-group">
        <view class="gender-chip {{form.gender==='MALE'?'active':''}}" bindtap="setGender" data-val="MALE">男</view>
        <view class="gender-chip {{form.gender==='FEMALE'?'active':''}}" bindtap="setGender" data-val="FEMALE">女</view>
      </view>
    </view>
    <view class="form-item"><text class="label">年龄</text><input class="input" type="number" placeholder="请输入年龄" value="{{form.age}}" bindinput="onFieldInput" data-field="age" /></view>
    <view class="form-item"><text class="label">学历</text><input class="input" placeholder="如：本科" value="{{form.education}}" bindinput="onFieldInput" data-field="education" /></view>
    <view class="form-item"><text class="label">专业</text><input class="input" placeholder="请输入专业" value="{{form.major}}" bindinput="onFieldInput" data-field="major" /></view>
    <view class="form-item"><text class="label">电话</text><input class="input" type="number" maxlength="11" placeholder="请输入手机号" value="{{form.phone}}" bindinput="onFieldInput" data-field="phone" /></view>
  </view>
  <view class="submit-section">
    <button class="submit-btn" loading="{{submitting}}" bindtap="submitProfile">提交资料</button>
  </view>
</view>
